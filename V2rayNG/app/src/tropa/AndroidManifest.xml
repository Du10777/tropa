<?xml version="1.0" encoding="utf-8"?>
<!--
  Tropa manifest overlay. Attached to the build type source sets (see tropa.gradle), so it is merged
  with a higher priority than the upstream main manifest.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Battery optimization exemption request (Tropa permissions screen). -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- Exact cellular network type: dangerous permission before Android 13, normal one since. -->
    <uses-permission
        android:name="android.permission.READ_PHONE_STATE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.READ_BASIC_PHONE_STATE" />
    <!-- Tropa installs its own updates from its GitHub releases. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application>

        <!-- The upstream screen stays available as the advanced mode (and on Android TV),
             but no longer appears in the phone launcher. -->
        <activity android:name="com.v2ray.ang.ui.main.MainActivity">
            <intent-filter tools:node="remove">
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Links and shared text are handled by Tropa, so the upstream handler gives them up. -->
        <activity android:name="com.v2ray.ang.ui.UrlSchemeActivity">
            <intent-filter tools:node="remove">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <intent-filter tools:node="remove">
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.BROWSABLE" />
                <category android:name="android.intent.category.DEFAULT" />

                <data android:scheme="v2rayng" />
                <data android:host="install-config" />
                <data android:host="install-sub" />
            </intent-filter>
        </activity>

        <activity
            android:name="io.github.du10777.tropa.ui.main.TropaMainActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name="io.github.du10777.tropa.ui.link.TropaLinkActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:noHistory="true"
            android:theme="@style/AppThemeDayNight.NoActionBar.Translucent">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.BROWSABLE" />
                <category android:name="android.intent.category.DEFAULT" />

                <data android:scheme="xsub" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.BROWSABLE" />
                <category android:name="android.intent.category.DEFAULT" />

                <data android:scheme="v2rayng" />
                <data android:host="install-config" />
                <data android:host="install-sub" />
            </intent-filter>
        </activity>

        <activity
            android:name="io.github.du10777.tropa.ui.connections.TropaConnectionsActivity"
            android:exported="false" />
        <activity
            android:name="io.github.du10777.tropa.ui.settings.TropaSettingsActivity"
            android:exported="false" />
        <activity
            android:name="io.github.du10777.tropa.ui.permissions.TropaPermissionsActivity"
            android:exported="false" />
        <activity
            android:name="io.github.du10777.tropa.ui.log.TropaLogActivity"
            android:exported="false" />
        <activity
            android:name="io.github.du10777.tropa.ui.settings.TropaProxyActivity"
            android:exported="false" />
        <activity
            android:name="io.github.du10777.tropa.ui.settings.TropaRoamingActivity"
            android:exported="false" />
        <activity
            android:name="io.github.du10777.tropa.ui.settings.TropaAppsActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name="io.github.du10777.tropa.ui.settings.TropaGeoActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name="io.github.du10777.tropa.ui.settings.TropaChecksActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name="io.github.du10777.tropa.ui.settings.TropaUpdatesActivity"
            android:exported="false" />
        <activity
            android:name="io.github.du10777.tropa.ui.settings.TropaWifiAnswersActivity"
            android:exported="false" />

        <!-- After an update installed from Tropa: the VPN that was on comes back. -->
        <receiver
            android:name="io.github.du10777.tropa.service.TropaUpdateReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Connection watchdog: lives in the VPN service process, starts and stops with the core. -->
        <receiver
            android:name="io.github.du10777.tropa.service.TropaServiceEventsReceiver"
            android:exported="false"
            android:process=":daemon">
            <intent-filter>
                <action android:name="${applicationId}.action.activity" />
                <action android:name="io.github.du10777.tropa.action.WAKE_WATCHDOG" />
                <action android:name="io.github.du10777.tropa.action.SUBSCRIPTION_CHANGED" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
